MODE=0 # 0 for Prod, 1 for local (no attestation)
PROXY_URL= # Url to tee_proxy. Will be used as initial url at startup.
INITIAL_OWNER=
EXTENSION_ID= # Extension ID of the TEE machine.
CHAIN_ID= # EVM chain ID, bound into the SET_MACHINE_PATH_LIST signed payload.
GOVERNANCE_SIGNERS= # Comma-separated 0x-prefixed addresses authorized to sign SET_MACHINE_PATH_LIST.
GOVERNANCE_THRESHOLD= # Minimum distinct GOVERNANCE_SIGNERS required per signed payload.